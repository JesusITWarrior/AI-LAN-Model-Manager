# Public-safe development settings only. Never commit real hosts, pairing
# material, credentials, model paths, or machine inventories.
LANMM_BIND_HOST=127.0.0.1
LANMM_PORT=7340
LANMM_INFERENCE_HOST=127.0.0.1
LANMM_INFERENCE_PORT=7341
# Omit LANMM_DATA_DIR to use the absolute <working-directory>/data default.
# If set, LANMM_DATA_DIR must already be an absolute, normalized local path.
# Log levels are case-sensitive: error, warn, info, or debug.
LANMM_LOG_LEVEL=info
LANMM_DISCOVERY_ENABLED=false
# Public inference is not supported and true is rejected.
LANMM_PUBLIC_INFERENCE_ENABLED=false
# TLS is required by default. false/false is deliberately supported only for
# loopback development; mutual TLS can never be required when TLS is disabled.
LANMM_TLS_REQUIRED=true
LANMM_MUTUAL_TLS_REQUIRED=true
